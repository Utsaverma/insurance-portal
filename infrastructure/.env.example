# eClaims POC environment. Docker Compose reads ONLY infrastructure/.env, so copy this file there:
#   cp infrastructure/.env.example infrastructure/.env
# then set JWT_SECRET_KEY (at least 32 characters), for example:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Never commit .env — it is gitignored.

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=eclaims
POSTGRES_PASSWORD=eclaims_secret
POSTGRES_DB=eclaims
DATABASE_URL=postgresql+asyncpg://eclaims:eclaims_secret@postgres:5432/eclaims

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
# Required. The auth service refuses to start with an empty or short secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# POC setting: long enough to run a full demo without a forced re-login.
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Service-to-service (inside the Docker network every service listens on 8000) ─
AUTH_SERVICE_URL=http://auth-service:8000
REDIS_URL=redis://redis:6379/0

# ── Workflow policy (FR3) ──────────────────────────────────────────────────────
# db: the claims service reads who may do what from the workflow_transitions and role_permissions tables
# (cached for 30 s, so a change there needs no redeploy), falling back to its built-in rules while they are
# empty. code: the built-in rules only.
WORKFLOW_SOURCE=db

# ── Host ports (change any that are already in use on your machine) ────────────
CUSTOMER_PORTAL_PORT=3000
INTERNAL_PORTAL_PORT=3001
AUTH_PORT=8001
CLAIMS_PORT=8002
POSTGRES_PORT=5432
REDIS_PORT=6379
# Mailpit web UI, where the notification emails land
MAIL_UI_PORT=8025
